{
    "name": "yepr/gitinsync",
    "description": "Joomla content in git: versioning, branches, restore and revert of articles, categories, fields, menus and tags, locally or on GitHub",
    "type": "joomla-package",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "Herman Peeren",
            "homepage": "https://yepr.nl"
        }
    ],
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpunit/phpunit": "^10.5 || ^11.0",
        "squizlabs/php_codesniffer": "^3.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Yepr\\Component\\GitInSync\\Administrator\\": "src/com_gitinsync/administrator/src/",
            "Yepr\\Plugin\\Content\\GitInSync\\": "src/plg_content_gitinsync/src/",
            "Yepr\\Plugin\\Task\\GitInSync\\": "src/plg_task_gitinsync/src/",
            "Yepr\\GitInSync\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G",
        "cs": "phpcs",
        "cs-fix": "php-cs-fixer fix",
        "cs-fix-dry": "php-cs-fixer fix --dry-run --diff",
        "build": "php build/build.php",
        "install-local": [
            "@build",
            "php tools/install-local.php"
        ],
        "cypress": "npx cypress run"
    },
    "config": {
        "sort-packages": true
    }
}
