{
  "_comment": [
    "Copy this to cypress.env.json and fill it in. That file is git-ignored,",
    "because it holds a login.",
    "",
    "baseUrl is the Joomla site GitInSync is installed on, in the mode 'Local repository'.",
    "adminUser and adminPassword are a Super User of that site."
  ],
  "baseUrl": "http://localhost/GitInSync/joomla",
  "adminUser": "yourusername",
  "adminPassword": "yourpassword"
}
