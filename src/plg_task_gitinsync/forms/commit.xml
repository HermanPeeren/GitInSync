<?xml version="1.0" encoding="UTF-8"?>
<form>
	<fields name="params">
		<fieldset name="task_params">
			<field
				name="time_budget"
				type="number"
				label="PLG_TASK_GITINSYNC_FIELD_TIME_BUDGET_LABEL"
				description="PLG_TASK_GITINSYNC_FIELD_TIME_BUDGET_DESC"
				default="20"
				min="3"
				max="120"
				filter="integer"
			/>
			<field
				name="scan"
				type="radio"
				label="PLG_TASK_GITINSYNC_FIELD_SCAN_LABEL"
				description="PLG_TASK_GITINSYNC_FIELD_SCAN_DESC"
				layout="joomla.form.field.radio.switcher"
				default="0"
				filter="integer"
				>
				<option value="0">JNO</option>
				<option value="1">JYES</option>
			</field>
			<field
				name="push"
				type="radio"
				label="PLG_TASK_GITINSYNC_FIELD_PUSH_LABEL"
				description="PLG_TASK_GITINSYNC_FIELD_PUSH_DESC"
				layout="joomla.form.field.radio.switcher"
				default="1"
				filter="integer"
				>
				<option value="0">JNO</option>
				<option value="1">JYES</option>
			</field>
		</fieldset>
	</fields>
</form>
